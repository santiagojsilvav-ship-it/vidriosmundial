{
  "name": "vidriosmundial",
  "version": "2.0.0",
  "private": true,
  "description": "Vidrios Mundial - sitio estático (public/). npm solo se usa para compilar Tailwind.",
  "scripts": {
    "build:css": "tailwindcss -i tailwind.input.css -o public/css/site.css --minify",
    "watch:css": "tailwindcss -i tailwind.input.css -o public/css/site.css --watch"
  },
  "devDependencies": {
    "tailwindcss": "3.4.19"
  }
}
